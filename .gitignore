# Python
__pycache__/
*.pyc
.venv/

# Airflow
airflow_home/

# Landed raw data snapshots
ETL/raw/*
ELT/raw/*
!**/raw/.gitkeep

# Secrets
.env
*.json
!*.example.json

# dbt
target/
dbt_packages/
logs/
.user.yml

# Local dbt profile (per-machine, has literal project/keyfile values) —
# airflow/dbt_profiles/profiles.yml is different: env_var()-driven, no
# secrets baked in, meant to be committed.
ELT/dbt/profiles.yml
!ELT/dbt/profiles.yml.example

# OS
.DS_Store
Thumbs.db

# Docs - keep README + every docs/ folder tracked, root-level *.md elsewhere are working notes
*.md
!README.md
!**/docs/**/*.md
